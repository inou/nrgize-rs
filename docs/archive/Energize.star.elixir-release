# Energize.star — Elixir release deploy (macOS → Linux via Docker)
#
# Workflow:
#   1. Build a Linux release inside Docker on your Mac
#   2. Upload the tarball to production
#   3. Unpack, migrate, restart
#
# Setup:
#   1. Fill in placeholders below (or use --var overrides)
#   2. Put your .envrc in the project root with production env vars
#   3. Run: nrg run deploy
#
# Commands:
#   nrg run deploy        # Full pipeline: build → upload → unpack → migrate → restart
#   nrg run build         # Just build the release locally
#   nrg run restart       # Just restart the app on production
#   nrg run rollback      # Roll back last migration + restart
#   nrg run status        # Check if app is running
#   nrg run logs          # Tail production logs
#   nrg run console       # Remote IEx shell

# ── Configuration ────────────────────────────────────────
# Override any of these with: nrg run deploy --var app=my_app

APP_NAME    = var("app",    default = "YOUR_APP_NAME")
DEPLOY_PATH = var("path",   default = "/opt/" + APP_NAME)
BRANCH      = var("branch", default = "main")

# ── Load .envrc ──────────────────────────────────────────
# Your .envrc should contain: DATABASE_URL, SECRET_KEY_BASE, PHX_HOST, PORT, etc.
# These get exported on the remote server when tasks with env=".envrc" run.

env_file(".envrc")

# ── Servers ──────────────────────────────────────────────

servers(
    production = "YOUR_SERVER_HOST",   # e.g. deploy@198.51.100.10
)

# ── Hooks ────────────────────────────────────────────────

before(script = 'echo "▸ $(date +%H:%M:%S) starting..."')
success(script = 'echo "✓ Done."')
error(script = 'echo "✗ Failed. Check output above."')

# ── Build release inside Docker (runs on YOUR Mac) ──────

task(
    name = "build",
    local = True,
    emoji = "🔨",
    script = """
        echo "▸ Building Linux release in Docker..."

        docker build \
            --build-arg APP_NAME=""" + APP_NAME + """ \
            --build-arg MIX_ENV=prod \
            -t """ + APP_NAME + """-builder \
            -f- . << 'DOCKERFILE'
        # ── Stage 1: build ──
        FROM hexpm/elixir:1.17.3-erlang-27.1.2-debian-bookworm-20241016 AS build

        ARG APP_NAME
        ARG MIX_ENV=prod

        RUN apt-get update && apt-get install -y build-essential git npm && rm -rf /var/lib/apt/lists/*

        WORKDIR /app

        RUN mix local.hex --force && mix local.rebar --force

        COPY mix.exs mix.lock ./
        RUN mix deps.get --only $MIX_ENV && mix deps.compile

        COPY assets/ assets/
        COPY config/ config/
        COPY lib/ lib/
        COPY priv/ priv/
        COPY rel/ rel/

        RUN if [ -f assets/package.json ]; then cd assets && npm install && cd ..; fi
        RUN mix assets.deploy 2>/dev/null || true
        RUN mix compile
        RUN mix release --overwrite

        # ── Stage 2: package ──
        FROM debian:bookworm-slim AS package

        ARG APP_NAME
        ARG MIX_ENV=prod

        WORKDIR /export
        COPY --from=build /app/_build/${MIX_ENV}/rel/${APP_NAME} ./${APP_NAME}
        RUN tar czf /export/${APP_NAME}.tar.gz -C /export ${APP_NAME}
        DOCKERFILE

        echo "▸ Extracting tarball from container..."
        CONTAINER_ID=$(docker create """ + APP_NAME + """-builder)
        docker cp "$CONTAINER_ID:/export/""" + APP_NAME + """.tar.gz" ./""" + APP_NAME + """.tar.gz
        docker rm "$CONTAINER_ID" > /dev/null

        ls -lh """ + APP_NAME + """.tar.gz
        echo "✓ Release built: """ + APP_NAME + """.tar.gz"
    """,
)

# ── Upload tarball to production ─────────────────────────

upload(
    name = "upload",
    src = "./" + APP_NAME + ".tar.gz",
    dest = DEPLOY_PATH + "/" + APP_NAME + ".tar.gz",
    on = ["production"],
    emoji = "📤",
)

# ── Unpack on server ─────────────────────────────────────

task(
    name = "unpack",
    on = ["production"],
    emoji = "📦",
    script = """
        echo "▸ Unpacking release..."
        cd """ + DEPLOY_PATH + """

        # Keep previous release for rollback
        if [ -d """ + APP_NAME + """ ]; then
            rm -rf """ + APP_NAME + """.prev
            mv """ + APP_NAME + " " + APP_NAME + """.prev
        fi

        tar xzf """ + APP_NAME + """.tar.gz
        rm -f """ + APP_NAME + """.tar.gz
        echo "✓ Unpacked to """ + DEPLOY_PATH + "/" + APP_NAME + """."
    """,
)

# ── Migrate ──────────────────────────────────────────────

task(
    name = "migrate",
    on = ["production"],
    env = ".envrc",
    emoji = "🗄️",
    script = """
        echo "▸ Running migrations..."
        """ + DEPLOY_PATH + "/" + APP_NAME + "/bin/" + APP_NAME + """ eval '""" + APP_NAME + """.Release.migrate()'
        echo "✓ Migrations complete."
    """,
)

# ── Stop / Start / Restart ───────────────────────────────

task(
    name = "stop",
    on = ["production"],
    env = ".envrc",
    emoji = "⏹️",
    script = """
        echo "▸ Stopping """ + APP_NAME + """..."
        """ + DEPLOY_PATH + "/" + APP_NAME + "/bin/" + APP_NAME + """ stop 2>/dev/null || true
        echo "✓ Stopped."
    """,
)

task(
    name = "start",
    on = ["production"],
    env = ".envrc",
    emoji = "▶️",
    script = """
        echo "▸ Starting """ + APP_NAME + """..."
        """ + DEPLOY_PATH + "/" + APP_NAME + "/bin/" + APP_NAME + """ daemon
        sleep 2
        """ + DEPLOY_PATH + "/" + APP_NAME + "/bin/" + APP_NAME + """ pid && echo "✓ Running (PID above)." || echo "✗ Failed to start!"
    """,
)

task(
    name = "restart",
    on = ["production"],
    env = ".envrc",
    emoji = "🔄",
    script = """
        echo "▸ Restarting """ + APP_NAME + """..."
        """ + DEPLOY_PATH + "/" + APP_NAME + "/bin/" + APP_NAME + """ stop 2>/dev/null || true
        sleep 1
        """ + DEPLOY_PATH + "/" + APP_NAME + "/bin/" + APP_NAME + """ daemon
        sleep 2
        """ + DEPLOY_PATH + "/" + APP_NAME + "/bin/" + APP_NAME + """ pid && echo "✓ Running (PID above)." || echo "✗ Failed to start!"
    """,
)

# ── Utility tasks ────────────────────────────────────────

task(
    name = "status",
    on = ["production"],
    env = ".envrc",
    emoji = "📊",
    script = """
        echo "▸ Checking """ + APP_NAME + """..."
        """ + DEPLOY_PATH + "/" + APP_NAME + "/bin/" + APP_NAME + """ pid && echo "✓ Running." || echo "✗ Not running."
        echo ""
        echo "▸ Release contents:"
        ls -la """ + DEPLOY_PATH + "/" + APP_NAME + """/releases/ 2>/dev/null || echo "(no releases found)"
    """,
)

task(
    name = "logs",
    on = ["production"],
    emoji = "📜",
    script = """
        tail -f """ + DEPLOY_PATH + "/" + APP_NAME + """/tmp/log/erlang.log.* 2>/dev/null || \
        echo "No log files found at """ + DEPLOY_PATH + "/" + APP_NAME + """/tmp/log/"
    """,
)

task(
    name = "console",
    on = ["production"],
    env = ".envrc",
    emoji = "💻",
    script = """
        """ + DEPLOY_PATH + "/" + APP_NAME + "/bin/" + APP_NAME + """ remote
    """,
)

task(
    name = "rollback",
    on = ["production"],
    env = ".envrc",
    confirm = "Roll back the last migration and restart?",
    emoji = "⏪",
    script = """
        echo "▸ Rolling back last migration..."
        """ + DEPLOY_PATH + "/" + APP_NAME + "/bin/" + APP_NAME + """ eval '""" + APP_NAME + """.Release.rollback(""" + APP_NAME + """.Repo, 1)'
        echo "▸ Restarting..."
        """ + DEPLOY_PATH + "/" + APP_NAME + "/bin/" + APP_NAME + """ stop 2>/dev/null || true
        sleep 1
        """ + DEPLOY_PATH + "/" + APP_NAME + "/bin/" + APP_NAME + """ daemon
        sleep 2
        """ + DEPLOY_PATH + "/" + APP_NAME + "/bin/" + APP_NAME + """ pid && echo "✓ Rolled back and running." || echo "✗ Failed to start!"
    """,
)

task(
    name = "revert",
    on = ["production"],
    env = ".envrc",
    confirm = "Revert to the previous release?",
    emoji = "↩️",
    script = """
        echo "▸ Reverting to previous release..."
        cd """ + DEPLOY_PATH + """

        if [ ! -d """ + APP_NAME + """.prev ]; then
            echo "✗ No previous release found."
            exit 1
        fi

        """ + APP_NAME + "/bin/" + APP_NAME + """ stop 2>/dev/null || true
        rm -rf """ + APP_NAME + """
        mv """ + APP_NAME + ".prev " + APP_NAME + """

        """ + APP_NAME + "/bin/" + APP_NAME + """ daemon
        sleep 2
        """ + APP_NAME + "/bin/" + APP_NAME + """ pid && echo "✓ Reverted and running." || echo "✗ Failed to start!"
    """,
)

# ── Clean up local build artifacts ───────────────────────

task(
    name = "clean",
    local = True,
    emoji = "🧹",
    script = """
        echo "▸ Cleaning up..."
        rm -f """ + APP_NAME + """.tar.gz
        docker rmi """ + APP_NAME + """-builder 2>/dev/null || true
        echo "✓ Cleaned."
    """,
)

# ── Macros ───────────────────────────────────────────────

# Full deploy: build on Mac → upload → unpack → migrate → restart → cleanup
define_macro(
    name = "deploy",
    tasks = ["build", "upload", "unpack", "migrate", "restart", "clean"],
)

# Just push + restart (skip build — reuse existing tarball)
define_macro(
    name = "push",
    tasks = ["upload", "unpack", "migrate", "restart"],
)

# First-time setup (doesn't build — just prepares the server)
define_macro(
    name = "setup",
    tasks = ["upload", "unpack", "start"],
)
